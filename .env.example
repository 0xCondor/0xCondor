# ============================================================
# Condor EASM — environment variables
# ============================================================

# App
APP_NAME=Condor EASM
APP_ENV=development
APP_SECRET_KEY=change-me-with-openssl-rand-hex-32
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Database (Postgres)
POSTGRES_USER=condor
POSTGRES_PASSWORD=condor_dev_password
POSTGRES_DB=condor
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://condor:condor_dev_password@postgres:5432/condor

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=14

# Scanning
SCAN_RATE_LIMIT_PER_DOMAIN=5
SCAN_MAX_SUBDOMAINS=500
SCAN_HTTP_TIMEOUT_SECONDS=8
SCAN_USER_AGENT=CondorEASM/1.0 (+https://condor-easm.example/bot)

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=changeme
SMTP_FROM=Condor EASM <notifications@example.com>

# Stripe (stub — sostituire in produzione)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_SOLO=price_placeholder_solo
STRIPE_PRICE_MSP=price_placeholder_msp
STRIPE_PRICE_MSP_PRO=price_placeholder_msp_pro

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Condor EASM
