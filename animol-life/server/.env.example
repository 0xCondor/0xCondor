# Animol Life server - copia in .env e compila. Nessuna variabile è obbligatoria:
# senza chiavi tutto funziona in modalità demo.

# --- Server ---
NODE_ENV=development
PORT=3000
# URL pubblico (https) usato nei link email, nei redirect Stripe e per verificare le firme Twilio
PUBLIC_BASE_URL=
# Dietro un proxy/load balancer (Render, Railway, Nginx) imposta 1 per leggere l'IP reale del client
TRUST_PROXY=
# Percorsi (relativi a server/)
PUBLIC_DIR=../public
DATA_DIR=data
# Sovrascrive la Content-Security-Policy di default (opzionale)
CONTENT_SECURITY_POLICY=

# --- Assistente IA (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ASSISTANT_MAX_HISTORY=12
ASSISTANT_MAX_CHARS=1500

# --- Rate limit (richieste per IP per finestra) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_ASSISTANT=20
RATE_LIMIT_ORDERS=10
RATE_LIMIT_FORMS=6
RATE_LIMIT_GENERAL=120

# --- Spedizione ---
SHIPPING_COST_CENTS=490

# --- Stripe (abbonamento Animol Plus) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Facoltativi: ID prezzo creati nella dashboard (altrimenti 5,99 €/mese e 49,90 €/anno creati al volo)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- Twilio (agente vocale) ---
TWILIO_AUTH_TOKEN=
# Numero dell'operatore umano in formato E.164, es. +390212345678
HUMAN_PHONE_NUMBER=
# Voce TTS facoltativa, es. Polly.Bianca o Google.it-IT-Standard-A
TWILIO_VOICE=

# --- Email ---
# Endpoint che riceve {to, from, subject, text, tag} in JSON e invia l'email (Brevo/Postmark/SES/Make/Zapier...)
EMAIL_WEBHOOK_URL=
EMAIL_FROM=Animol Life <ciao@animol.life>
# Destinatario di avvisi scorte e report vendite
ALERT_EMAIL=

# --- Automazioni ---
ABANDONED_CART_HOURS=24
LOW_STOCK_THRESHOLD=5

# --- Dirette Plus ---
LIVE_PROVIDER=demo
