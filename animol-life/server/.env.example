# Animol Life server - copia in .env e compila. Nessuna variabile è obbligatoria:
# senza chiavi tutto funziona in modalità demo.

# --- Server ---
NODE_ENV=development
PORT=3000
# URL pubblico (https) usato nei link email, nei redirect Stripe e per verificare le firme Twilio
PUBLIC_BASE_URL=
# Dietro un proxy/load balancer (Render, Railway, Nginx) imposta 1 per leggere l'IP reale del client
TRUST_PROXY=
# Percorsi (relativi a server/)
PUBLIC_DIR=../public
# Landing B2B servita su /vendita/
VENDITA_DIR=../vendita
# Database SQLite (animol.db) e file JSON: mettila su un disco persistente con backup
DATA_DIR=data
# products.json riscritto dal database dopo ogni modifica del catalogo (default ../public/products.json; "off" per disattivare)
CATALOG_EXPORT_FILE=
# Sovrascrive la Content-Security-Policy di default (opzionale)
CONTENT_SECURITY_POLICY=

# --- Assistente IA (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ASSISTANT_MAX_HISTORY=12
ASSISTANT_MAX_CHARS=1500

# --- Rate limit (richieste per IP per finestra) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_ASSISTANT=20
RATE_LIMIT_ORDERS=10
RATE_LIMIT_FORMS=6
RATE_LIMIT_GENERAL=120
# Accesso/registrazione/reset password per IP al minuto (x3 su 15 minuti)
RATE_LIMIT_AUTH=10
# Richieste dal modulo B2B /vendita/ per IP per finestra
RATE_LIMIT_LEADS=5

# --- Account clienti e sessioni ---
# Durata massima della sessione e scadenza per inattività (giorni)
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=14
# Durata della sessione del pannello admin (ore)
ADMIN_SESSION_HOURS=8
# Costo scrypt (N, potenza di 2). 32768 ≈ 50-100 ms per hash su un server tipico
SCRYPT_COST=32768
# Cookie Secure: auto (sempre in produzione/https e su localhost) | true | false
COOKIE_SECURE=auto
# Blocco dell'accesso: tentativi falliti per email in 15 minuti e durata del blocco
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# --- Pannello admin (/admin) ---
# Se entrambe impostate, l'admin viene creato/allineato a ogni avvio (password di almeno 12 caratteri).
# Se vuote, al primo avvio viene creato admin@animol.local con una password casuale stampata UNA volta nel log.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Spedizione ---
SHIPPING_COST_CENTS=490

# --- Pagamenti ---
# Stripe: ordini (Checkout una tantum: carta, PayPal e altri metodi attivati nella dashboard) e abbonamento Plus
STRIPE_SECRET_KEY=
# Signing secret del webhook /api/stripe/webhook (obbligatorio con Stripe: gli ordini diventano "pagati" solo dal webhook)
STRIPE_WEBHOOK_SECRET=
# Facoltativi: ID prezzo creati nella dashboard (altrimenti 5,99 €/mese e 49,90 €/anno creati al volo)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# PayPal Checkout nativo (Orders API v2), facoltativo: se impostato, "PayPal" al checkout usa PayPal direttamente
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox
# Pagina di pagamento simulata (DEMO) quando non ci sono chiavi: attiva di default fuori produzione, mai in produzione salvo 1
DEMO_PAYMENTS=

# --- Twilio (agente vocale) ---
TWILIO_AUTH_TOKEN=
# Numero dell'operatore umano in formato E.164, es. +390212345678
HUMAN_PHONE_NUMBER=
# Voce TTS facoltativa, es. Polly.Bianca o Google.it-IT-Standard-A
TWILIO_VOICE=

# --- Email ---
# Endpoint che riceve {to, from, subject, text, tag} in JSON e invia l'email (Brevo/Postmark/SES/Make/Zapier...)
EMAIL_WEBHOOK_URL=
EMAIL_FROM=Animol Life <ciao@animol.life>
# Destinatario di avvisi scorte, report vendite e nuovi contatti B2B (se vuoto si usa ADMIN_EMAIL)
ALERT_EMAIL=

# --- Automazioni ---
ABANDONED_CART_HOURS=24
LOW_STOCK_THRESHOLD=5
# Promemoria Plus: giorni prima della fine della prova e del rinnovo annuale
PLUS_TRIAL_REMINDER_DAYS=3
PLUS_RENEWAL_REMINDER_DAYS=30

# --- Dirette Plus ---
LIVE_PROVIDER=demo
